: 3}, "history": [{"role": "assistant", "payload": {"messages": ["**Hati:** Hi, there. Today's scenario is a big one: presenting your project objectives to a thesis panel. This is a classic performance situation. The fear is real, but you can practice handling it. I'll be right here with you."], "message": "**Hati:** Hi, there. Today's scenario is a big one: presenting your project objectives to a thesis panel. This is a classic performance situation. The fear is real, but you can practice handling it. I'll be right here with you.", "ui": {"type": "buttons", "options": ["Begin"]}}}, {"role": "user", "payload": {"text": "Begin"}}, {"role": "assistant", "payload": {"messages": ["**Hati:** You're standing at the front of the room. Five professors are watching you.", "**Hati:** Let me introduce them: Professor 1 (Dr. Reyes) \u2013 Middle, neutral expression, taking notes. Professor 2 (Dr. Cruz) \u2013 Stern-looking, arms crossed. Professor 3 (Dr. Santos) \u2013 Appears supportive, slight nod. Professor 4 (Dr. Garcia) \u2013 Silent, staring at laptop. Professor 5 (Dr. Lopez) \u2013 Older, seems tired but attentive.", "**Hati:** They're taking notes. Some have neutral expressions, some look stern. The room is quiet. You're about to present the objectives of your project.", "**Hati:** Before you begin, let's do a Physical, Intellectual, Emotional, and Social check.", "**Hati:** How does your body feel?"], "message": "**Hati:** You're standing at the front of the room. Five professors are watching you.", "ui": {"type": "buttons", "options": ["Tense", "Heart racing", "Shaky", "Sweaty", "Dry mouth", "Normal"]}}}, {"role": "user", "payload": {"text": "Heart racing"}}, {"role": "assistant", "payload": {"messages": ["**Hati:** What are you feeling?"], "message": "**Hati:** What are you feeling?", "ui": {"type": "buttons", "options": ["Anxious", "Scared", "Neutral", "Calm", "Irritable", "Overwhelmed"]}}}, {"role": "user", "payload": {"text": "Scared"}}, {"role": "assistant", "payload": {"messages": ["**Hati:** What do you notice first?"], "message": "**Hati:** What do you notice first?", "ui": {"type": "buttons", "options": ["Professors staring", "The clock", "Your notes", "The exit door", "The podium"]}}}, {"role": "user", "payload": {"text": "Professors staring"}}, {"role": "assistant", "payload": {"messages": ["**Hati:** I notice you selected Heart racing. That's completely normal when facing something important. Your body is preparing for something meaningful. Let's work with that energy.", "**Hati:** First, what is the title of your project? Type it below (even a short version is fine)."], "message": "**Hati:** I notice you selected Heart racing. That's completely normal when facing something important. Your body is preparing for something meaningful. Let's work with that energy.", "ui": {"type": "text_input", "placeholder": "Project title..."}}}, {"role": "user", "payload": {"text": "Skibidi toilet"}}, {"role": "assistant", "payload": {"messages": ["**Hati:** Good. Now choose an opening line (or custom).", "A. \"Good morning, esteemed panel. Today I will present the objectives of my project titled 'Skibidi toilet'.\"", "B. \"Hello. My project is about Skibidi toilet \u2014 here are my objectives.\"", "C. \"Thank you for being here. My objectives are: first...\""], "message": "**Hati:** Good. Now choose an opening line (or custom).", "ui": {"type": "buttons", "options": ["Use option A (formal)", "Use option B (simple)", "Use option C (minimal)", "Custom opening"]}}}, {"role": "user", "payload": {"text": "Use option A (formal)"}}, {"role": "assistant", "payload": {"messages": ["**Hati:** Great. Now practice saying that opening line silently in your head three times. Then take a breath."], "message": "**Hati:** Great. Now practice saying that opening line silently in your head three times. Then take a breath.", "ui": {"type": "buttons", "options": ["Continue"]}}}, {"role": "user", "payload": {"text": "Continue"}}, {"role": "assistant", "